{
  "name": "web-stack-template",
  "private": true,
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "dotenv": "^17.4.2",
      "effect": "^3.22.1",
      "@effect/vitest": "^0.30.0",
      "vitest": "^3.2.7",
      "zod": "^4.4.3",
      "typescript": "^6.0.3",
      "@types/bun": "^1.4.0",
      "@types/node": "^26.2.0",
      "libsql": "0.5.29",
      "hono": "^4.12.32",
      "@orpc/server": "^1.14.12",
      "@orpc/openapi": "^1.14.12",
      "@orpc/zod": "^1.14.12",
      "better-auth": "1.7.1",
      "ai": "^7.0.41",
      "lucide-react": "^1.27.0",
      "next-themes": "^0.4.6",
      "react": "^19.2.8",
      "react-dom": "^19.2.8",
      "sonner": "^2.0.7",
      "@orpc/client": "^1.14.12",
      "@polar-sh/better-auth": "^1.8.4",
      "@tailwindcss/postcss": "^4.3.3",
      "@types/react": "^19.2.17",
      "@types/react-dom": "^19.2.3",
      "tailwindcss": "^4.3.3",
      "drizzle-orm": "^0.45.2"
    }
  },
  "type": "module",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "oxlint apps packages scripts --deny-warnings",
    "test": "turbo run test",
    "check-types": "turbo run check-types",
    "dev:web": "turbo run dev -F web --",
    "dev:server": "turbo run dev -F server --",
    "db:push": "turbo run db:push -F @web-stack-template/db --",
    "db:studio": "turbo run db:studio -F @web-stack-template/db --",
    "db:generate": "turbo run db:generate -F @web-stack-template/db --",
    "db:migrate": "turbo run db:migrate -F @web-stack-template/db --",
    "db:local": "turbo run db:local -F @web-stack-template/db --",
    "deploy:setup": "vercel link",
    "dev:vercel": "vercel dev -L",
    "env:preview": "tsx scripts/sync-vercel-env.ts preview",
    "env:production": "tsx scripts/sync-vercel-env.ts production",
    "deploy": "vercel deploy",
    "deploy:prod": "vercel deploy --prod",
    "deploy:check": "vercel deploy --dry",
    "docker:build": "docker compose build",
    "docker:up": "docker compose up -d --build",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f"
  },
  "dependencies": {
    "@web-stack-template/env": "workspace:*",
    "dotenv": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/bun": "catalog:",
    "@types/node": "catalog:",
    "@web-stack-template/config": "workspace:*",
    "oxlint": "^1.81.0",
    "tsx": "^4.23.1",
    "turbo": "^2.10.12",
    "typescript": "catalog:",
    "vercel": "^58.1.0"
  },
  "packageManager": "bun@1.4.0"
}
