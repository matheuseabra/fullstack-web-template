{
  "name": "server",
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "build": "tsdown",
    "check-types": "tsc -b",
    "compile": "bun build --compile --minify --sourcemap --bytecode ./src/index.ts --outfile server",
    "dev": "bun run --hot src/index.ts",
    "start": "bun run dist/index.mjs"
  },
  "dependencies": {
    "@ai-sdk/devtools": "^1.0.8",
    "@ai-sdk/openai": "^4.0.59",
    "@orpc/openapi": "catalog:",
    "@orpc/server": "catalog:",
    "@orpc/zod": "catalog:",
    "@web-stack-template/api": "workspace:*",
    "@web-stack-template/auth": "workspace:*",
    "@web-stack-template/db": "workspace:*",
    "@web-stack-template/env": "workspace:*",
    "ai": "catalog:",
    "better-auth": "catalog:",
    "dotenv": "catalog:",
    "effect": "catalog:",
    "hono": "catalog:",
    "libsql": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/bun": "catalog:",
    "@web-stack-template/config": "workspace:*",
    "tsdown": "^0.22.14",
    "typescript": "catalog:"
  }
}
